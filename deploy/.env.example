# ============================================================
#  Plantilla de variables de entorno del despliegue.
#  Copiar a deploy/.env y completar.  ¡NUNCA commitear deploy/.env!
#      cp deploy/.env.example deploy/.env
# ============================================================

# Identidad del proyecto (nombres de contenedores, routers de Traefik)
PROJECT_NAME=vivisanroque

# Dominio público servido por Traefik
DOMAIN=vivisanroque.munisanroque.ar

# Puerto local SOLO para pruebas con docker-compose.yml (en el VPS lo maneja Traefik)
PORT=8080

# --- Backend de clima (OpenWeatherMap) ---
# Obtener una API key gratuita en https://openweathermap.org/api
OWM_API_KEY=OWM_API_KEY=test
OWM_UNITS=metric
OWM_LANG=es
WEATHER_CACHE_TTL_MS=600000

# --- Backend de Admin (Panel de administración) ---
# Usuario del panel de administración
ADMIN_USER=admin

# Hash bcrypt de la contraseña del admin.
# Para generarlo, dentro del contenedor (o localmente con node):
#   node -e "const b=require('bcryptjs');b.hash('TU_CONTRASEÑA',12).then(h=>console.log(h));"
# Reemplazá el valor de abajo con el hash generado.
ADMIN_PASSWORD_HASH=

# Secreto de sesión (mínimo 32 caracteres aleatorios)
# Generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=b50ed46867dc41d79db6f124c2b745d36943bbbe7aeb46ca06888d66f6ff8a77

# Contraseña de desarrollo (solo usar en local, NO en producción)
# Si está seteada, permite login sin hash bcrypt. Dejar vacío en producción.
ADMIN_DEV_PASSWORD=123456
