# Plantilla .env para despliegue (copiar a .env y ajustar valores)
# Proyecto
PROJECT_NAME=vivisanroque
# Dominio público (usado por deploy/docker-compose.vps.yml)
DOMAIN=vivisanroque.munisanroque.ar

# Puertos (local dev)
PORT=8080

# Admin
ADMIN_PORT=4000
NODE_ENV=production

# --- Backend de Bot (OpenRouter) ---
# Obtener una API key en https://openrouter.ai/
# Formatos soportados: openai, openrouter, anthropic, ollama, generic
# BOT_API_URL=https://openrouter.ai/api/v1/chat/completions
# BOT_API_KEY=
# BOT_PROVIDER=openrouter

# Slots de proveedores adicionales para rotación automática.
# BOT_API_URL_1=https://api.openai.com/v1/chat/completions
# BOT_API_KEY_1=
# BOT_PROVIDER_1=openai
# BOT_API_URL_2=https://api.anthropic.com/v1/chat/completions
# BOT_API_KEY_2=
# BOT_PROVIDER_2=anthropic
# BOT_TIMEOUT_MS=8000

# Opcional: si quieres que los contenedores usen rutas host en la VPS
# (cuando quieres montar /srv/vivisanroque/data en vez de volúmenes Docker)
HOST_ADMIN_DATA=/srv/vivisanroque/admin_data
