{
  "name": "vivisanroque-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Portal turístico de San Roque, Corrientes. Sitio estático; este paquete solo compila las utilidades de Tailwind.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css/src/tailwind.css -o css/tw-base.css --minify",
    "watch:css": "npm run build:css -- --watch",
    "test": "node --test \"tests/*.test.js\" \"test/*.test.js\""
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
